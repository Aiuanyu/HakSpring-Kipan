<?xml version="1.0" encoding="utf-8"?>
<input-method xmlns:android="http://schemas.android.com/apk/res/android"
    android:icon="@mipmap/ic_launcher"
    android:isDefault="false"
    android:settingsActivity="com.siansiansu.taigikeyboard.settings.SettingsMainActivity"
    android:supportsSwitchingToNextInputMethod="true">

    <!-- CROSS-PLATFORM INVARIANT (INVARIANT_KEYBOARD_LOCALE_NEUTRAL_TAG) — mirrors
         ios/Sources/TaigiKeyboard/KeyboardExtension/Info.plist PrimaryLanguage. languageTag="mul"
         (Multiple languages) keeps "Chinese" out of the OS keyboard list; do NOT use nan/zh.
         imeSubtypeLocale is intentionally absent (deprecated; an OEM reading it could re-surface
         "Min Nan Chinese"). -->
    <!-- Hakfa fork: one subtype per lect (腔), so each shows in the system's keyboard language list.
         extraValue names the lect code (`HakfaLects`): 1 四縣, 6 南四縣, 2 海陸, 3 大埔, 4 饒平, 5 詔安. -->
    <subtype
        android:label="@string/ime_subtype_sixian"
        android:languageTag="mul"
        android:imeSubtypeMode="keyboard"
        android:imeSubtypeExtraValue="lect=1" />
    <subtype
        android:label="@string/ime_subtype_namxiian"
        android:languageTag="mul"
        android:imeSubtypeMode="keyboard"
        android:imeSubtypeExtraValue="lect=6" />
    <subtype
        android:label="@string/ime_subtype_hoiliug"
        android:languageTag="mul"
        android:imeSubtypeMode="keyboard"
        android:imeSubtypeExtraValue="lect=2" />
    <subtype
        android:label="@string/ime_subtype_taibu"
        android:languageTag="mul"
        android:imeSubtypeMode="keyboard"
        android:imeSubtypeExtraValue="lect=3" />
    <subtype
        android:label="@string/ime_subtype_ngiaupin"
        android:languageTag="mul"
        android:imeSubtypeMode="keyboard"
        android:imeSubtypeExtraValue="lect=4" />
    <subtype
        android:label="@string/ime_subtype_zhioon"
        android:languageTag="mul"
        android:imeSubtypeMode="keyboard"
        android:imeSubtypeExtraValue="lect=5" />

</input-method>
